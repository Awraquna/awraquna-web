{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "awraquna-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Next's data cache. Without it every page view re-fetches the whole API from
  // the origin; with it, a response is fetched once per revalidate window and
  // served from the edge for everyone after that.
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "d1e12784e53343b7bfaba51b83bc99c4" }
  ],

  "observability": {
    "enabled": true
  },
  // Public API base URL the site fetches from. Override per deploy with:
  //   npx wrangler deploy --var NEXT_PUBLIC_API_URL:https://api.example.com
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://awraquna.runasp.net",
    "REVALIDATE_SECONDS": "60"
  }
}
