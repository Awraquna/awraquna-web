# Development defaults, committed so `npm install && npm run dev` just works.
# Next loads this only for `next dev`, so it can never leak into a production
# build the way a localhost-pinned `.env.local` silently does.
NEXT_PUBLIC_API_URL=http://localhost:5200

# 0 = always fresh, so admin edits show up immediately while developing.
REVALIDATE_SECONDS=0
