# Production defaults, committed on purpose (see .gitignore) — the API base is a
# public URL, not a secret, and keeping it in the repo makes a deploy reproducible.
#
# Next loads this for `next build` / `next start`. Note that a local `.env.local`
# WINS over this file, so a production build made on a dev machine must not have
# `.env.local` pinning localhost.
NEXT_PUBLIC_API_URL=https://awraquna.runasp.net

# Seconds the site caches API data. 60 keeps the public site fast while still
# picking up admin edits within a minute.
REVALIDATE_SECONDS=60
